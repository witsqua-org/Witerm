<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.witerm.agent</string>
    <key>BundleProgram</key>
    <string>Contents/Library/LaunchServices/WitermAgent.app/Contents/MacOS/witerm-agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>witerm-agent</string>
        <string>--app-group</string>
        <string>__WITERM_APP_GROUP__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
