            "state" : "translated",
            "value" : "%@ (can’t pair devices)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（无法配对设备）"
          }
        }
      }
    },
    "%@ Joined" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Joined"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已加入"
          }
        }
      }
    },
    "%@ answered, but it isn’t a Witerm relay server. If Witerm runs behind a reverse proxy such as nginx, check that the proxy forwards /v1/ and /readyz." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ answered, but it isn’t a Witerm relay server. If Witerm runs behind a reverse proxy such as nginx, check that the proxy forwards /v1/ and /readyz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 有响应，但它不是 Witerm 中继服务器。如果 Witerm 运行在 nginx 等反向代理之后，请确认代理转发了 /v1/ 和 /readyz。"
          }
        }
      }
    },
    "%@ can no longer open its terminals. To use them again, pair again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can no longer open its terminals. To use them again, pair again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将无法再打开它的终端。要再次使用，请重新配对。"
          }
        }
      }
    },
    "%@ can’t pair devices" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can’t pair devices"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法配对设备"
          }
        }
      }
    },
    "%@ didn’t answer. Check your network, or that the relay server is running." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ didn’t answer. Check your network, or that the relay server is running."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。请检查网络，或确认中继服务器正在运行。"
          }
        }
      }
    },
    "%@ is already paired with this Mac. It can open this terminal from Terminals if you allow it in Settings → Devices." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already paired with this Mac. It can open this terminal from Terminals if you allow it in Settings → Devices."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已与这台 Mac 配对。只要你在“设置”→“设备”中允许，它就可以从“终端”中打开此终端。"
          }
        }
      }
    },
    "%@ is running but not ready. Its database may be unavailable. Try again shortly." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is running but not ready. Its database may be unavailable. Try again shortly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行但尚未就绪，可能是数据库不可用。请稍后重试。"
          }
        }
      }
    },
    "%@ joined" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
