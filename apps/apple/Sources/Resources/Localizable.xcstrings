    },
    "The host did not respond in time. Check the network, firewall, or VPN, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host did not respond in time. Check the network, firewall, or VPN, then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机未及时响应。请检查网络、防火墙或 VPN，然后重试。"
          }
        }
      }
    },
    "The host does not accept this sign-in method. Use a password or an Ed25519 key it allows." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host does not accept this sign-in method. Use a password or an Ed25519 key it allows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主机不接受该登录方式。请使用它允许的密码或 Ed25519 密钥。"
          }
        }
      }
    },
    "The host key has changed, so the connection was blocked. Check with the host’s administrator first." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host key has changed, so the connection was blocked. Check with the host’s administrator first."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机密钥已变化，因此已阻止连接。请先向该主机的管理员核实。"
          }
        }
      }
    },
    "The host key has changed. Review it again before continuing." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host key has changed. Review it again before continuing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机密钥已变化，请重新查看后再操作。"
          }
        }
      }
    },
    "The host offers no algorithms Witerm considers secure, so the connection was stopped. Ask its administrator to enable modern algorithms." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host offers no algorithms Witerm considers secure, so the connection was stopped. Ask its administrator to enable modern algorithms."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主机未提供 Witerm 认为安全的算法，连接已停止。请联系其管理员启用现代算法。"
          }
        }
      }
    },
    "The host refused the connection. Check the port and that its SSH server is running." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host refused the connection. Check the port and that its SSH server is running."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝了连接。请检查端口，并确认其 SSH 服务器正在运行。"
