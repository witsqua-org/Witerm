    "%@ refused the connection. Check the port, and that Witerm is running there." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ refused the connection. Check the port, and that Witerm is running there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 拒绝了连接。请检查端口，并确认 Witerm 正在该处运行。"
          }
        }
      }
    },
    "%@ runs a Witerm version this app can’t use. Update the relay server or the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs a Witerm version this app can’t use. Update the relay server or the app."
