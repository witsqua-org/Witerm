        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 运行的 Witerm 版本无法与此应用配合使用。请更新中继服务器或应用。"
          }
        }
      }
    },
    "%@ unpaired" : {
      "extractionState" : "manual",
