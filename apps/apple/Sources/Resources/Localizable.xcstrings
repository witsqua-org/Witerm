    "SSH closes when Witerm goes to the background" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH closes when Witerm goes to the background"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witerm 进入后台时 SSH 会关闭"
          }
        }
      }
    },
    "SSH connections close when this app goes to the background. Remote programs follow the host’s session rules." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH connections close when this app goes to the background. Remote programs follow the host’s session rules."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 App 进入后台时会断开 SSH。远程程序是否继续运行取决于主机的会话规则。"
          }
        }
      }
    },
    "SSH connects directly and needs no continuation server. What you type is never stored or sent anywhere else." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH connects directly and needs no continuation server. What you type is never stored or sent anywhere else."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH 直接连接，不需要接续服务器。你输入的内容不会被存储，也不会发送到其他地方。"
          }
        }
      }
    },
    "SSH disconnected when the app went to the background. Reconnect to open a new shell; previous programs depend on the remote host." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH disconnected when the app went to the background. Reconnect to open a new shell; previous programs depend on the remote host."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 进入后台时已断开 SSH。重新连接会打开新的 Shell，之前的程序是否继续运行取决于远程主机。"
          }
        }
      }
    },
    "SSH hosts and paired devices can't be reached. Terminals on this Mac keep running. Reconnect when the network returns; earlier input is never resent." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH hosts and paired devices can't be reached. Terminals on this Mac keep running. Reconnect when the network returns; earlier input is never resent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问 SSH 主机和已配对设备。这台 Mac 上的终端会继续运行。网络恢复后请重新连接；之前的输入绝不会重新发送。"
          }
        }
      }
    },
    "SSH hosts and your other devices can't be reached. Reconnect when the network returns; earlier input is never resent." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH hosts and your other devices can't be reached. Reconnect when the network returns; earlier input is never resent."
