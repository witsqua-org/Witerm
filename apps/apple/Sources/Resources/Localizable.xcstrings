    },
    "%@. %@ no longer opens its terminals, but the relay server wasn’t told. Try again, or unpair on the other device." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. %@ no longer opens its terminals, but the relay server wasn’t told. Try again, or unpair on the other device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@。%2$@已不再打开它的终端，但中继服务器尚未收到通知。请重试，或在另一台设备上取消配对。"
          }
        }
      }
    },
    "%@’s certificate isn’t trusted. Check the certificate, or this device’s date and time." : {
